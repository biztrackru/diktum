{
  "name": "diktum-public-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:gcp": "NEXT_OUTPUT_STANDALONE=1 next build --webpack",
    "start": "vinext start",
    "start:gcp": "next start -H 0.0.0.0 -p ${PORT:-8080}",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "type": "module",
  "overrides": {
    "baseline-browser-mapping": "2.11.29",
    "browserslist": "4.29.3",
    "fast-uri": "3.1.8",
    "fflate": "0.8.3",
    "esbuild": "0.28.2"
  }
}
