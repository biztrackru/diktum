# Copy this file to .env and fill local secrets.
# Never commit .env.

# Hugging Face token with read access to pyannote/speaker-diarization-community-1
HF_TOKEN=hf_your_token_here

# Optional: LM Studio local server for transcript post-processing.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=google/gemma-4-12b
